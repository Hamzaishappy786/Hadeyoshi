{
  "name": "video-editor",
  "version": "1.0.0",
  "description": "Personal desktop video editor",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run frontend\" \"wait-on http-get://localhost:8000/health http-get://localhost:5173 && set NODE_ENV=development&& electron .\"",
    "electron": "electron .",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && python -m uvicorn main:app --port 8000 --reload",
    "build": "cd frontend && npm run build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "pack": "electron-builder"
  },
  "build": {
    "appId": "com.hadeyosh.videoeditor",
    "productName": "Hadeyosh",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!venv/**",
          "!__pycache__/**",
          "!*.pyc",
          "!projects/*.db"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.0.0"
  }
}
